{
  "schema_version": 3,
  "id": "duct_fitting",
  "name": "风管管件",
  "version": 2,
  "category": "风侧模块",
  "description": "按局部阻力系数 K 换算阀门等效 Kv 的矩形风管管件（弯头/三通/变径/进出口），并累计通过质量。K 为教学默认值，可用 custom 覆盖。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "fitting_type",
      "label": "管件类型",
      "value_type": "text",
      "default": "elbow_90"
    },
    {
      "id": "loss_coefficient",
      "label": "局部阻力系数 K（custom 时使用）",
      "value_type": "number",
      "default": 0.3,
      "minimum": 0.0,
      "maximum": 100.0
    },
    {
      "id": "duct_width_m",
      "label": "断面宽",
      "value_type": "number",
      "default": 0.4,
      "minimum": 0.01,
      "unit": {
        "quantity": "length",
        "canonical_unit": "m",
        "display_unit": "mm",
        "display_scale": 0.001
      }
    },
    {
      "id": "duct_height_m",
      "label": "断面高",
      "value_type": "number",
      "default": 0.4,
      "minimum": 0.01,
      "unit": {
        "quantity": "length",
        "canonical_unit": "m",
        "display_unit": "mm",
        "display_scale": 0.001
      }
    },
    {
      "id": "density_kg_m3",
      "label": "参考密度",
      "value_type": "number",
      "default": 1.2,
      "minimum": 0.1,
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    }
  ],
  "variables": [
    {
      "id": "loss_coefficient",
      "label": "有效局部阻力系数 K",
      "quantity": "ratio",
      "source": "derived",
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "1"
      }
    },
    {
      "id": "velocity_m_s",
      "label": "断面平均流速",
      "quantity": "velocity",
      "source": "derived",
      "unit": {
        "quantity": "velocity",
        "canonical_unit": "m/s",
        "display_unit": "m/s"
      }
    },
    {
      "id": "state.throughput_kg",
      "label": "累计通过质量",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "valve",
      "enabled": true
    }
  ],
  "solver_model": "generic",
  "source_format": "python-v1",
  "sdk": {
    "api_version": "0.6.0",
    "capabilities": [
      "lifecycle.v1",
      "state.json.v1",
      "properties.v1",
      "net.valve",
      "air.properties.v1",
      "air.pass_through.v1"
    ],
    "state_contract_version": 1
  }
}
