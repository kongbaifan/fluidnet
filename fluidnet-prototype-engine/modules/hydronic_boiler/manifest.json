      "quantity": "power",
      "unit": {
        "quantity": "power",
        "canonical_unit": "W",
        "display_unit": "kW",
        "display_scale": 1000.0,
        "display_offset": 0.0
      },
      "source": "derived",
      "writable": false,
      "sampleable": true,
      "parameter_id": null,
      "port_id": null
    },
    {
      "id": "flue_loss_w",
      "label": "未进入水侧的热损",
      "quantity": "power",
      "unit": {
        "quantity": "power",
        "canonical_unit": "W",
        "display_unit": "kW",
        "display_scale": 1000.0,
        "display_offset": 0.0
      },
      "source": "derived",
      "writable": false,
      "sampleable": true,
      "parameter_id": null,
      "port_id": null
    },
    {
      "id": "state.heat_energy_j",
      "label": "累计供热",
      "quantity": "energy",
      "unit": {
        "quantity": "energy",
        "canonical_unit": "J",
        "display_unit": "kWh",
        "display_scale": 3600000.0,
        "display_offset": 0.0
      },
      "source": "state",
      "writable": false,
      "sampleable": true,
      "parameter_id": null,
      "port_id": null
    },
    {
      "id": "state.fuel_energy_j",
      "label": "累计燃料输入",
      "quantity": "energy",
      "unit": {
        "quantity": "energy",
        "canonical_unit": "J",
        "display_unit": "kWh",
        "display_scale": 3600000.0,
        "display_offset": 0.0
      },
      "source": "state",
      "writable": false,
      "sampleable": true,
      "parameter_id": null,
      "port_id": null
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
