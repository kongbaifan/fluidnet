      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "hot"
    },
    {
      "id": "hot_out",
      "label": "热侧出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "hot"
    },
    {
      "id": "cold_in",
      "label": "冷侧入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "cold"
    },
    {
      "id": "cold_out",
      "label": "冷侧出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "cold"
    }
  ],
  "parameters": [
