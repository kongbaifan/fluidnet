{
  "schema_version": 1,
  "id": "capillary_tube",
  "name": "毛细管",
  "version": 1,
  "category": "倍思鹿参考模块",
  "description": "毛细管/毛细节流阀的单相液体近似：按细长圆管阻力关系注册水力支路，输出流通面积、平均流速并累计通过质量。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "diameter_m",
      "label": "毛细管内径",
      "value_type": "number",
      "default": 0.0015,
      "minimum": 0.0001,
      "maximum": 0.05,
      "unit": {
        "quantity": "length",
        "canonical_unit": "m",
        "display_unit": "mm",
        "display_scale": 0.001
      }
    },
    {
      "id": "length_m",
      "label": "毛细管长度",
      "value_type": "number",
      "default": 1.5,
      "minimum": 0.0,
      "maximum": 100.0,
      "unit": {
        "quantity": "length",
        "canonical_unit": "m",
        "display_unit": "m"
      }
    },
    {
      "id": "roughness_m",
      "label": "绝对粗糙度",
      "value_type": "number",
      "default": 1.5e-06,
      "minimum": 0.0,
      "maximum": 0.001,
      "unit": {
        "quantity": "length",
        "canonical_unit": "m",
        "display_unit": "mm",
        "display_scale": 0.001
      }
    },
    {
      "id": "density_kg_m3",
      "label": "参考密度",
      "value_type": "number",
      "default": 998.2,
      "minimum": 1.0,
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    },
    {
      "id": "viscosity_pa_s",
      "label": "动力黏度",
      "value_type": "number",
      "default": 0.001,
      "minimum": 0.0,
      "unit": {
        "quantity": "dynamic_viscosity",
        "canonical_unit": "Pa·s",
        "display_unit": "mPa·s",
        "display_scale": 0.001
      }
    }
  ],
  "variables": [
    {
      "id": "flow_area_m2",
      "label": "流通面积",
      "quantity": "area",
      "source": "derived",
      "unit": {
        "quantity": "area",
        "canonical_unit": "m²",
        "display_unit": "m²"
      }
    },
    {
      "id": "mean_velocity_m_s",
      "label": "平均流速",
      "quantity": "velocity",
      "source": "derived",
      "unit": {
        "quantity": "velocity",
        "canonical_unit": "m/s",
        "display_unit": "m/s"
      }
    },
    {
      "id": "state.throughput_kg",
      "label": "累计通过质量",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "pipe",
      "enabled": true
    }
  ],
  "solver_model": "generic",
  "source_format": "python-v1"
}
