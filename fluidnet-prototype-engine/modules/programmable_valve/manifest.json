{
  "schema_version": 1,
  "id": "programmable_valve",
  "name": "可编程阀门",
  "version": 1,
  "category": "自定义模块",
  "description": "通过 Python evaluate 注册阀门阻力关系，并在 commit_step 中累计通过质量。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "opening_ratio",
      "label": "阀门开度",
      "value_type": "number",
      "default": 0.8,
      "minimum": 0.0,
      "maximum": 1.0
    },
    {
      "id": "kv_m3_h",
      "label": "流量系数 Kv",
      "value_type": "number",
      "default": 16.0,
      "minimum": 0.001
    }
  ],
  "variables": [
    {
      "id": "density_kg_m3",
      "label": "参考密度",
      "quantity": "density",
      "source": "derived",
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    },
    {
      "id": "opening_ratio",
      "label": "有效开度",
      "quantity": "ratio",
      "source": "derived",
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "%",
        "display_scale": 0.01
      }
    },
    {
      "id": "state.throughput_kg",
      "label": "累计通过质量",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    },
    {
      "id": "state.commit_count",
      "label": "已接受时间步",
      "quantity": "count",
      "source": "state"
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "valve",
      "enabled": true
    }
  ],
  "solver_model": "valve",
  "source_format": "python-v1",
  "bank_names": [
    "额定工况",
    "部分负荷",
    "调试备份"
  ]
}
