{
  "schema_version": 1,
  "id": "check_valve",
  "name": "止回阀",
  "version": 1,
  "category": "倍思鹿参考模块",
  "description": "按进出口压差判断流向的止回阀参考模块：反向压差超过开启压力时关断并累计关断步数。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "kv_m3_h",
      "label": "流量系数 Kv",
      "value_type": "number",
      "default": 50.0,
      "minimum": 0.001,
      "unit": {
        "quantity": "flow_coefficient",
        "canonical_unit": "m³/h",
        "display_unit": "m³/h"
      }
    },
    {
      "id": "opening_ratio",
      "label": "正向开度",
      "value_type": "number",
      "default": 1.0,
      "minimum": 0.0,
      "maximum": 1.0
    },
    {
      "id": "cracking_pressure_pa",
      "label": "反向开启压差",
      "value_type": "number",
      "default": 0.0,
      "minimum": 0.0,
      "unit": {
        "quantity": "pressure",
        "canonical_unit": "Pa",
        "display_unit": "kPa",
        "display_scale": 1000.0
      }
    },
    {
      "id": "density_kg_m3",
      "label": "参考密度",
      "value_type": "number",
      "default": 998.2,
      "minimum": 1.0,
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    }
  ],
  "variables": [
    {
      "id": "opening_ratio",
      "label": "有效开度",
      "quantity": "ratio",
      "source": "derived",
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "%",
        "display_scale": 0.01
      }
    },
    {
      "id": "direction",
      "label": "流向（+1 正向，-1 反向）",
      "quantity": "ratio",
      "source": "derived"
    },
    {
      "id": "state.closed_steps",
      "label": "反向关断步数",
      "quantity": "count",
      "source": "state"
    },
    {
      "id": "state.throughput_kg",
      "label": "累计通过质量",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "valve",
      "enabled": true
    }
  ],
  "solver_model": "generic",
  "source_format": "python-v1"
}
