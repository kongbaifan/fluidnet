{
  "schema_version": 1,
  "id": "pump_variable_speed",
  "name": "变速水泵",
  "version": 1,
  "category": "倍思鹿参考模块",
  "description": "按扬程-流量曲线与转速比注册泵曲线关系的变速水泵参考模块：输出扬程、轴功率与电功率并累计能量。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "head_curve",
      "label": "扬程-流量曲线（流量 m³/h，扬程 m）",
      "value_type": "curve",
      "default": [[0, 20], [10, 18], [20, 12], [30, 0]]
    },
    {
      "id": "nominal_flow_m3_h",
      "label": "额定流量",
      "value_type": "number",
      "default": 10.0,
      "minimum": 0.0,
      "unit": {
        "quantity": "volume_flow",
        "canonical_unit": "m³/h",
        "display_unit": "m³/h"
      }
    },
    {
      "id": "speed_ratio",
      "label": "转速比",
      "value_type": "number",
      "default": 1.0,
      "minimum": 0.05,
      "maximum": 2.0,
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "1"
      }
    },
    {
      "id": "efficiency",
      "label": "水泵效率",
      "value_type": "number",
      "default": 0.7,
      "minimum": 0.05,
      "maximum": 1.0,
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "%",
        "display_scale": 0.01
      }
    },
    {
      "id": "motor_efficiency",
      "label": "电机效率",
      "value_type": "number",
      "default": 0.9,
      "minimum": 0.05,
      "maximum": 1.0,
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "%",
        "display_scale": 0.01
      }
    },
    {
      "id": "density_kg_m3",
      "label": "水参考密度",
      "value_type": "number",
      "default": 998.2,
      "minimum": 1.0,
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    },
    {
      "id": "viscosity_pa_s",
      "label": "水动力黏度",
      "value_type": "number",
      "default": 0.001,
      "minimum": 0.0,
      "unit": {
        "quantity": "dynamic_viscosity",
        "canonical_unit": "Pa·s",
        "display_unit": "mPa·s",
        "display_scale": 0.001
      }
    }
  ],
  "variables": [
    {
      "id": "pump_head_m",
      "label": "水泵扬程",
      "quantity": "head",
      "source": "derived",
      "unit": {
        "quantity": "head",
        "canonical_unit": "m",
        "display_unit": "m"
      }
    },
    {
      "id": "shaft_power_w",
      "label": "轴功率",
      "quantity": "power",
      "source": "derived",
      "unit": {
        "quantity": "power",
        "canonical_unit": "W",
        "display_unit": "W"
      }
    },
    {
      "id": "electric_power_w",
      "label": "电功率",
      "quantity": "power",
      "source": "derived",
      "unit": {
        "quantity": "power",
        "canonical_unit": "W",
        "display_unit": "W"
      }
    },
    {
      "id": "state.shaft_energy_j",
      "label": "累计轴功",
      "quantity": "energy",
      "source": "state",
      "unit": {
        "quantity": "energy",
        "canonical_unit": "J",
        "display_unit": "kJ",
        "display_scale": 1000.0
      }
    },
    {
      "id": "state.electric_energy_j",
      "label": "累计电能",
      "quantity": "energy",
      "source": "state",
      "unit": {
        "quantity": "energy",
        "canonical_unit": "J",
        "display_unit": "kJ",
        "display_scale": 1000.0
      }
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "水路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "pump_curve",
      "solver_model": "pump",
      "enabled": true
    }
  ],
  "solver_model": "generic",
  "source_format": "python-v1"
}
