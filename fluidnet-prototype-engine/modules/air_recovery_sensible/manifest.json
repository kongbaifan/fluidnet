{
  "schema_version": 3,
  "id": "air_recovery_sensible",
  "name": "双风道显热回收器",
  "version": 1,
  "category": "暖通基础设备",
  "description": "两条独立风路显热ε–NTU，无漏风、水分交换和储热；各路湿量透传，凝结/结霜不支持，端口温度须不低于0°C。旁通是UA折减，不隐含额外风路。",
  "ports": [
    {
      "id": "exhaust_in",
      "label": "排风入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "exhaust"
    },
    {
      "id": "exhaust_out",
      "label": "排风出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "exhaust"
    },
    {
      "id": "supply_in",
      "label": "新风入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "supply"
    },
    {
      "id": "supply_out",
      "label": "新风出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "supply"
    }
  ],
  "parameters": [
    {
      "id": "ua_w_k",
      "label": "清洁显热UA",
      "value_type": "number",
      "default": 1000.0,
      "unit": {
        "quantity": "conductance",
        "canonical_unit": "W/K",
        "display_unit": "kW/K",
        "display_scale": 1000.0,
        "display_offset": 0.0
      },
      "minimum": 0.0,
      "maximum": null,
      "runtime": false,
      "writable": true
    },
    {
