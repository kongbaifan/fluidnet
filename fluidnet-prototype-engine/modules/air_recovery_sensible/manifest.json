        "display_offset": 0.0
      },
      "minimum": 0.0,
      "maximum": 1.0,
      "runtime": true,
      "writable": true
    },
    {
      "id": "exhaust_diameter_m",
      "label": "排风等效内径",
      "value_type": "number",
