{
  "schema_version": 3,
  "version": 1,
  "runtime": "python",
  "entrypoint": "module:Module",
  "category": "自定义关系示范",
  "solver_model": "generic",
  "source_format": "python-v1",
  "sdk": {
    "api_version": "0.8.0",
    "capabilities": [
      "net.pressure_drop",
      "state.transactions.v1",
      "context.execution.v1",
      "observe.v1",
      "evaluate.pure.v1",
      "hydraulic.signed_start.v1"
    ]
  },
  "pure_evaluate": true,
  "applicability": {
    "execution_domains": [
      "fluid"
    ],
    "phases": [
      "liquid",
      "gas"
    ],
    "assumptions": [
      "单相、无独立物理储量、被动压降；参数仅为公式演示，不代表厂家标定"
    ]
  },
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "direction": "in"
    },
    {
      "id": "out0",
      "label": "出口",
      "direction": "out"
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "generic",
      "enabled": true
    }
  ],
  "variables": [
    {
      "id": "actual_drop_pa",
      "label": "实际压降",
      "source": "derived",
      "quantity": "pressure",
      "unit": {
        "quantity": "pressure",
        "canonical_unit": "Pa",
        "display_unit": "kPa",
        "display_scale": 1000
      }
    },
    {
      "id": "state.transferred_mass_kg",
      "label": "累计通过质量",
      "source": "state",
      "quantity": "mass",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    }
  ],
  "id": "porous_filter",
  "name": "自定义多孔滤芯",
  "description": "按当前流量计算线性加二次压降，堵塞比例可运行时调整。",
  "parameters": [
    {
      "id": "linear_coefficient",
      "label": "线性系数 [Pa/(kg/s)]",
      "default": 12000,
      "minimum": 1
    },
    {
      "id": "quadratic_coefficient",
      "label": "二次系数 [Pa/(kg/s)²]",
      "default": 4000,
      "minimum": 0
    },
    {
      "id": "clogging_ratio",
      "label": "堵塞附加比例",
      "default": 0,
      "minimum": 0,
      "maximum": 10,
      "runtime": true,
      "writable": true
    }
  ]
}
