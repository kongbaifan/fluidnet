{
  "schema_version": 1,
  "id": "valve_equal_percentage",
  "name": "等百分比调节阀",
  "version": 1,
  "category": "倍思鹿参考模块",
  "description": "复刻倍思鹿截止阀等百分比特性曲线的调节阀参考模块：按 ALF/LF 计算 CVF 并折算为阀门 Kv，开度 0 时精确关断。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "kv_m3_h",
      "label": "额定流量系数 Kv",
      "value_type": "number",
      "default": 16.0,
      "minimum": 0.001,
      "unit": {
        "quantity": "flow_coefficient",
        "canonical_unit": "m³/h",
        "display_unit": "m³/h"
      }
    },
    {
      "id": "opening_ratio",
      "label": "阀门开度",
      "value_type": "number",
      "default": 0.5,
      "minimum": 0.0,
      "maximum": 1.0,
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "%",
        "display_scale": 0.01
      }
    },
    {
      "id": "rangeability_alf",
      "label": "可调比 ALF",
      "value_type": "number",
      "default": 100.0,
      "minimum": 1.0,
      "maximum": 1000.0
    },
    {
      "id": "leakage_fraction",
      "label": "泄漏系数 LF",
      "value_type": "number",
      "default": 0.0,
      "minimum": 0.0,
      "maximum": 0.5
    },
    {
      "id": "density_kg_m3",
      "label": "参考密度",
      "value_type": "number",
      "default": 998.2,
      "minimum": 1.0,
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    }
  ],
  "variables": [
    {
      "id": "cvf",
      "label": "等百分比当量流通系数 CVF",
      "quantity": "ratio",
      "source": "derived",
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "1"
      }
    },
    {
      "id": "effective_kv_m3_h",
      "label": "有效流量系数 Kv",
      "quantity": "flow_coefficient",
      "source": "derived",
      "unit": {
        "quantity": "flow_coefficient",
        "canonical_unit": "m³/h",
        "display_unit": "m³/h"
      }
    },
    {
      "id": "state.throughput_kg",
      "label": "累计通过质量",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "valve",
      "enabled": true
    }
  ],
  "solver_model": "generic",
  "source_format": "python-v1"
}
