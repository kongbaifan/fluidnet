{
  "schema_version": 1,
  "id": "check_valve",
  "name": "止回阀",
  "version": 2,
  "category": "倍思鹿参考模块",
  "description": "V2 语义修正：正向开启压差 p_crack_pa 之后按阀门阻力律通过，Δp ≤ p_crack（含全部反向）时精确零流量；可选迟滞仅用于动态开关抖振。",
  "entrypoint": "module:Module",
  "ports": [
    {
      "id": "in0",
      "label": "入口",
      "domain": "fluid",
      "direction": "in",
      "required": true,
      "circuit": "fluid"
    },
    {
      "id": "out0",
      "label": "出口",
      "domain": "fluid",
      "direction": "out",
      "required": true,
      "circuit": "fluid"
    }
  ],
  "parameters": [
    {
      "id": "kv_m3_h",
      "label": "流量系数 Kv",
      "value_type": "number",
      "default": 50.0,
      "minimum": 0.001,
      "unit": {
        "quantity": "flow_coefficient",
        "canonical_unit": "m³/h",
        "display_unit": "m³/h"
      }
    },
    {
      "id": "p_crack_pa",
      "label": "正向开启压差 p_crack",
      "value_type": "number",
      "default": 0.0,
      "minimum": 0.0,
      "unit": {
        "quantity": "pressure",
        "canonical_unit": "Pa",
        "display_unit": "kPa",
        "display_scale": 1000.0
      }
    },
    {
      "id": "opening_ratio",
      "label": "正向最大开度",
      "value_type": "number",
      "default": 1.0,
      "minimum": 0.0,
      "maximum": 1.0
    },
    {
      "id": "hysteresis_pa",
      "label": "迟滞带宽（0 为无迟滞）",
      "value_type": "number",
      "default": 0.0,
      "minimum": 0.0,
      "unit": {
        "quantity": "pressure",
        "canonical_unit": "Pa",
        "display_unit": "kPa",
        "display_scale": 1000.0
      }
    },
    {
      "id": "density_kg_m3",
      "label": "参考密度",
      "value_type": "number",
      "default": 998.2,
      "minimum": 1.0,
      "unit": {
        "quantity": "density",
        "canonical_unit": "kg/m³",
        "display_unit": "kg/m³"
      }
    },
    {
      "id": "cracking_pressure_pa",
      "label": "v1 遗留参数“反向开启压差”（v2 不再使用）",
      "value_type": "number",
      "default": 0.0,
      "minimum": 0.0,
      "unit": {
        "quantity": "pressure",
        "canonical_unit": "Pa",
        "display_unit": "kPa",
        "display_scale": 1000.0
      }
    }
  ],
  "variables": [
    {
      "id": "opening_ratio",
      "label": "有效开度",
      "quantity": "ratio",
      "source": "derived",
      "unit": {
        "quantity": "ratio",
        "canonical_unit": "1",
        "display_unit": "%",
        "display_scale": 0.01
      }
    },
    {
      "id": "is_open",
      "label": "是否开启（1 开启 / 0 关闭）",
      "quantity": "ratio",
      "source": "derived"
    },
    {
      "id": "direction",
      "label": "压差方向（+1 正向，-1 反向或零）",
      "quantity": "ratio",
      "source": "derived"
    },
    {
      "id": "state.is_open",
      "label": "已提交开启状态",
      "quantity": "ratio",
      "source": "state"
    },
    {
      "id": "state.closed_steps",
      "label": "关闭步数",
      "quantity": "count",
      "source": "state"
    },
    {
      "id": "state.open_steps",
      "label": "开启步数",
      "quantity": "count",
      "source": "state"
    },
    {
      "id": "state.throughput_kg",
      "label": "累计通过质量",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    },
    {
      "id": "state.reverse_throughput_kg",
      "label": "累计反向通过质量（应为 0 或负的求解容差量）",
      "quantity": "mass",
      "source": "state",
      "unit": {
        "quantity": "mass",
        "canonical_unit": "kg",
        "display_unit": "kg"
      }
    }
  ],
  "channels": [
    {
      "id": "main",
      "name": "主通路",
      "input_port": "in0",
      "output_port": "out0",
      "relation": "resistance",
      "solver_model": "valve",
      "enabled": true
    }
  ],
  "solver_model": "generic",
  "source_format": "python-v1"
}
