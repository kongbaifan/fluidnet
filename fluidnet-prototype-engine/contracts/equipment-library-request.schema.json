{
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "prefix": {
      "default": "Own",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$",
      "title": "Prefix",
      "type": "string"
    },
    "room_count": {
      "default": 1,
      "maximum": 4,
      "minimum": 1,
      "title": "Room Count",
      "type": "integer"
    },
    "compressor_count": {
      "default": 1,
      "maximum": 4,
      "minimum": 1,
      "title": "Compressor Count",
      "type": "integer"
    }
  },
  "required": [
    "name"
  ],
  "title": "LibraryRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
