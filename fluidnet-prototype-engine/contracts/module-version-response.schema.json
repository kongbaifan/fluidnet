{
  "$defs": {
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "input_port": {
          "title": "Input Port",
          "type": "string"
        },
        "output_port": {
          "title": "Output Port",
          "type": "string"
        },
        "relation": {
          "enum": [
            "resistance",
            "pump_curve",
            "pressure_source",
            "heat_transfer",
            "signal"
          ],
          "title": "Relation",
          "type": "string"
        },
        "solver_model": {
          "title": "Solver Model",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "input_port",
        "output_port",
        "relation",
        "solver_model"
      ],
      "title": "ChannelSpec",
      "type": "object"
    },
    "CommitStepResponse": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "title": "CommitStepResponse",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "in",
        "out",
        "bidirectional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Domain": {
      "enum": [
        "fluid",
        "thermal",
        "refrigerant",
        "info",
        "power",
        "mech"
      ],
      "title": "Domain",
      "type": "string"
    },
    "EvaluateResponse": {
      "additionalProperties": false,
      "properties": {
        "relations": {
          "items": {
            "$ref": "#/$defs/NetworkRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "title": "EvaluateResponse",
      "type": "object"
    },
    "FluidConfig": {
      "additionalProperties": false,
      "description": "Serializable fluid selection passed to the property service.",
      "properties": {
        "backend": {
          "const": "coolprop",
          "default": "coolprop",
          "title": "Backend",
          "type": "string"
        },
        "fluid": {
          "default": "Water",
          "title": "Fluid",
          "type": "string"
        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        },
        "reference": {
          "default": "mass",
          "enum": [
            "mass",
            "mole"
          ],
          "title": "Reference",
          "type": "string"
        },
        "phase_policy": {
          "default": "single_phase",
          "enum": [
            "single_phase",
            "liquid",
            "gas",
            "any"
          ],
          "title": "Phase Policy",
          "type": "string"
        }
      },
      "title": "FluidConfig",
      "type": "object"
    },
    "ModuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "category": {
          "default": "自定义模块",
          "title": "Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "title": "Ports",
          "type": "array"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Parameters",
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableSpec"
          },
          "title": "Variables",
          "type": "array"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "title": "Channels",
          "type": "array"
        },
        "solver_model": {
          "default": "generic",
          "title": "Solver Model",
          "type": "string"
        },
        "state_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Model"
        },
        "thermal_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermal Model"
        },
        "source_format": {
          "default": "python-v1",
          "title": "Source Format",
          "type": "string"
        },
        "source": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Source",
          "type": "object"
        },
        "runtime": {
          "default": "builtin",
          "enum": [
            "builtin",
            "python"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "entrypoint": {
          "default": "",
          "title": "Entrypoint",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "definition_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Hash"
        },
        "package_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Path"
        },
        "bank_names": {
          "items": {
            "type": "string"
          },
          "title": "Bank Names",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ModuleDefinition",
      "type": "object"
    },
    "ModulePackageRef": {
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Module Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "definition_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Hash"
        }
      },
      "required": [
        "module_id",
        "version",
        "content_hash"
      ],
      "title": "ModulePackageRef",
      "type": "object"
    },
    "ModuleTestConditions": {
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "fluid": {
          "$ref": "#/$defs/FluidConfig"
        },
        "inlet_pressure_pa": {
          "default": 250000.0,
          "exclusiveMinimum": 0,
          "title": "Inlet Pressure Pa",
          "type": "number"
        },
        "outlet_pressure_pa": {
          "default": 120000.0,
          "exclusiveMinimum": 0,
          "title": "Outlet Pressure Pa",
          "type": "number"
        },
        "temperature_k": {
          "default": 293.15,
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "duration_s": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Duration S",
          "type": "number"
        },
        "dt_s": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Dt S",
          "type": "number"
        }
      },
      "title": "ModuleTestConditions",
      "type": "object"
    },
    "ModuleTestResponse": {
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        },
        "evaluation": {
          "$ref": "#/$defs/EvaluateResponse"
        },
        "committed": {
          "$ref": "#/$defs/CommitStepResponse"
        },
        "frame": {
          "$ref": "#/$defs/RunFrame"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/RunFrame"
          },
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "module_id",
        "content_hash",
        "evaluation",
        "committed",
        "frame"
      ],
      "title": "ModuleTestResponse",
      "type": "object"
    },
    "NetworkRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Relation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pipe",
            "valve",
            "pump",
            "compressor",
            "resistance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "channel": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Channel",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "relation_id",
        "kind",
        "channel"
      ],
      "title": "NetworkRelation",
      "type": "object"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value_type": {
          "default": "number",
          "enum": [
            "number",
            "boolean",
            "text",
            "curve"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "default": {
          "title": "Default"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "runtime": {
          "default": false,
          "title": "Runtime",
          "type": "boolean"
        },
        "writable": {
          "default": true,
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "default"
      ],
      "title": "ParameterSpec",
      "type": "object"
    },
    "PortSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain",
          "default": "fluid"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "bidirectional"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "circuit": {
          "default": "fluid",
          "title": "Circuit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "PortSpec",
      "type": "object"
    },
    "RunFrame": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "title": "Status",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "time_s": {
          "title": "Time S",
          "type": "number"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "full": {
          "default": true,
          "title": "Full",
          "type": "boolean"
        },
        "sequence": {
          "default": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "parameter_revision": {
          "default": 0,
          "title": "Parameter Revision",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "valid",
        "time_s"
      ],
      "title": "RunFrame",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        },
        "display_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Display Scale",
          "type": "number"
        },
        "display_offset": {
          "default": 0.0,
          "title": "Display Offset",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "canonical_unit",
        "display_unit"
      ],
      "title": "UnitSpec",
      "type": "object"
    },
    "VariableSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "enum": [
            "parameter",
            "port",
            "state",
            "derived",
            "system"
          ],
          "title": "Source",
          "type": "string"
        },
        "writable": {
          "default": false,
          "title": "Writable",
          "type": "boolean"
        },
        "sampleable": {
          "default": true,
          "title": "Sampleable",
          "type": "boolean"
        },
        "parameter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Id"
        },
        "port_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port Id"
        }
      },
      "required": [
        "id",
        "label",
        "quantity",
        "source"
      ],
      "title": "VariableSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "package": {
      "$ref": "#/$defs/ModulePackageRef"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "release_notes": {
      "default": "",
      "title": "Release Notes",
      "type": "string"
    },
    "tested": {
      "default": false,
      "title": "Tested",
      "type": "boolean"
    },
    "module": {
      "$ref": "#/$defs/ModuleDefinition"
    },
    "test_conditions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModuleTestConditions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "test_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModuleTestResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "package",
    "module"
  ],
  "title": "ModuleVersionResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
