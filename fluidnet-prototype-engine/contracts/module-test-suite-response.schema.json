{
  "$defs": {
    "CommitStepResponse": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "title": "CommitStepResponse",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Id"
        },
        "module_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Version"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "channel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "first_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Time S"
        },
        "last_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Time S"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "EvaluateResponse": {
      "additionalProperties": false,
      "properties": {
        "relations": {
          "items": {
            "$ref": "#/$defs/NetworkRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "accessed_ports": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
            "type": "string"
          },
          "title": "Accessed Ports",
          "type": "array"
        },
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        }
      },
      "title": "EvaluateResponse",
      "type": "object"
    },
    "ModuleTestAssertionResult": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Key",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "absolute_tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Absolute Tolerance",
          "type": "number"
        },
        "relative_tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Relative Tolerance",
          "type": "number"
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "absolute_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Error"
        },
        "allowed_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Error"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "outside_tolerance",
            "missing",
            "non_numeric",
            "non_finite",
            "not_evaluated"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "key",
        "expected",
        "passed",
        "status"
      ],
      "title": "ModuleTestAssertionResult",
      "type": "object"
    },
    "ModuleTestCaseResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "level": {
          "const": "L3",
          "default": "L3",
          "title": "Level",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleTestResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/ModuleTestAssertionResult"
          },
          "title": "Assertions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "passed",
        "input_hash"
      ],
      "title": "ModuleTestCaseResult",
      "type": "object"
    },
    "ModuleTestResponse": {
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        },
        "evaluation": {
          "$ref": "#/$defs/EvaluateResponse"
        },
        "committed": {
          "$ref": "#/$defs/CommitStepResponse"
        },
        "frame": {
          "$ref": "#/$defs/RunFrame"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/RunFrame"
          },
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "module_id",
        "content_hash",
        "evaluation",
        "committed",
        "frame"
      ],
      "title": "ModuleTestResponse",
      "type": "object"
    },
    "NetworkRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Relation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pipe",
            "valve",
            "pump",
            "compressor",
            "resistance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "channel": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Channel",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "relation_id",
        "kind",
        "channel"
      ],
      "title": "NetworkRelation",
      "type": "object"
    },
    "RunFrame": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "title": "Status",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "time_s": {
          "title": "Time S",
          "type": "number"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "solve_counters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solve Counters"
        },
        "solve_summary": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solve Summary"
        },
        "full": {
          "default": true,
          "title": "Full",
          "type": "boolean"
        },
        "sequence": {
          "default": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "parameter_revision": {
          "default": 0,
          "title": "Parameter Revision",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "valid",
        "time_s"
      ],
      "title": "RunFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "module_id": {
      "title": "Module Id",
      "type": "string"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "definition_hash": {
      "title": "Definition Hash",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ModuleTestCaseResult"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "module_id",
    "content_hash",
    "definition_hash",
    "passed",
    "cases"
  ],
  "title": "ModuleTestSuiteResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
