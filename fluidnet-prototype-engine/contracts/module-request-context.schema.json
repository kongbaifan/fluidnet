{
  "additionalProperties": false,
  "description": "Optional transport metadata; callback phase/time are derived from the action itself.",
  "properties": {
    "request_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
      "title": "Request Id",
      "type": "string"
    },
    "step_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Id"
    },
    "accepted_time_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Time S"
    },
    "port_data": {
      "default": "trial",
      "enum": [
        "trial",
        "converged"
      ],
      "title": "Port Data",
      "type": "string"
    }
  },
  "required": [
    "request_id"
  ],
  "title": "ModuleRequestContext",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
