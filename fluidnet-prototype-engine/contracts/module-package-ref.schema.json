{
  "additionalProperties": false,
  "properties": {
    "module_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
      "title": "Module Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "module_id",
    "version",
    "content_hash"
  ],
  "title": "ModulePackageRef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
