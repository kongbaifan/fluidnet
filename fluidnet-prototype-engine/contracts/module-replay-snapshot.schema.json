{
  "$defs": {
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "input_port": {
          "title": "Input Port",
          "type": "string"
        },
        "output_port": {
          "title": "Output Port",
          "type": "string"
        },
        "relation": {
          "enum": [
            "resistance",
            "pump_curve",
            "pressure_source",
            "heat_transfer",
            "signal"
          ],
          "title": "Relation",
          "type": "string"
        },
        "solver_model": {
          "title": "Solver Model",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "input_port",
        "output_port",
        "relation",
        "solver_model"
      ],
      "title": "ChannelSpec",
      "type": "object"
    },
    "ChannelState": {
      "additionalProperties": false,
      "properties": {
        "dry_air_mass_flow_kg_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dry Air Mass Flow Kg S"
        },
        "inlet_mass_flow_kg_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inlet Mass Flow Kg S"
        },
        "outlet_mass_flow_kg_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outlet Mass Flow Kg S"
        },
        "mass_flow_kg_s": {
          "default": 0.0,
          "title": "Mass Flow Kg S",
          "type": "number"
        },
        "pressure_drop_pa": {
          "default": 0.0,
          "title": "Pressure Drop Pa",
          "type": "number"
        },
        "heat_w": {
          "default": 0.0,
          "title": "Heat W",
          "type": "number"
        }
      },
      "title": "ChannelState",
      "type": "object"
    },
    "CompositeChild": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "module_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Module Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "definition_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Hash",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "id",
        "module_id",
        "version",
        "definition_hash"
      ],
      "title": "CompositeChild",
      "type": "object"
    },
    "CompositeConnection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CompositeEndpoint"
        },
        "target": {
          "$ref": "#/$defs/CompositeEndpoint"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "CompositeConnection",
      "type": "object"
    },
    "CompositeDefinition": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/CompositeChild"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Children",
          "type": "array"
        },
        "modules": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 100,
          "title": "Modules",
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/CompositeConnection"
          },
          "maxItems": 500,
          "title": "Connections",
          "type": "array"
        },
        "external_ports": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,80}$": {
              "$ref": "#/$defs/CompositeEndpoint"
            }
          },
          "title": "External Ports",
          "type": "object"
        },
        "parameter_maps": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,80}$": {
              "items": {
                "$ref": "#/$defs/CompositeParameterTarget"
              },
              "type": "array"
            }
          },
          "title": "Parameter Maps",
          "type": "object"
        },
        "output_aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Output Aliases",
          "type": "object"
        }
      },
      "required": [
        "children",
        "external_ports"
      ],
      "title": "CompositeDefinition",
      "type": "object"
    },
    "CompositeEndpoint": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Instance Id",
          "type": "string"
        },
        "port_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "port_id"
      ],
      "title": "CompositeEndpoint",
      "type": "object"
    },
    "CompositeParameterTarget": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Instance Id",
          "type": "string"
        },
        "parameter_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Parameter Id",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "parameter_id"
      ],
      "title": "CompositeParameterTarget",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Id"
        },
        "module_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Version"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "channel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "first_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Time S"
        },
        "last_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Time S"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "in",
        "out",
        "bidirectional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Domain": {
      "enum": [
        "fluid",
        "thermal",
        "refrigerant",
        "info",
        "power",
        "mech"
      ],
      "title": "Domain",
      "type": "string"
    },
    "FluidConfig": {
      "additionalProperties": false,
      "description": "Serializable fluid selection passed to the property service.",
      "properties": {
        "backend": {
          "const": "coolprop",
          "default": "coolprop",
          "title": "Backend",
          "type": "string"
        },
        "fluid": {
          "default": "Water",
          "title": "Fluid",
          "type": "string"
        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        },
        "reference": {
          "default": "mass",
          "enum": [
            "mass",
            "mole"
          ],
          "title": "Reference",
          "type": "string"
        },
        "phase_policy": {
          "default": "single_phase",
          "enum": [
            "single_phase",
            "liquid",
            "gas",
            "any"
          ],
          "title": "Phase Policy",
          "type": "string"
        }
      },
      "title": "FluidConfig",
      "type": "object"
    },
    "ModuleApplicability": {
      "additionalProperties": false,
      "properties": {
        "execution_domains": {
          "items": {
            "const": "fluid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Execution Domains",
          "type": "array"
        },
        "phases": {
          "items": {
            "enum": [
              "liquid",
              "gas"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "fluids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Fluids",
          "type": "array"
        },
        "limits": {
          "items": {
            "$ref": "#/$defs/ModuleOperatingLimit"
          },
          "maxItems": 128,
          "title": "Limits",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "ModuleApplicability",
      "type": "object"
    },
    "ModuleDefinition": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "sdk"
              ]
            }
          },
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  2,
                  3,
                  4
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "sdk": {
                "type": "object"
              },
              "runtime": {
                "const": "python"
              }
            },
            "required": [
              "sdk",
              "runtime"
            ]
          }
        },
        {
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "hydraulic_dependencies"
                  ]
                },
                {
                  "required": [
                    "dependency_mode"
                  ]
                },
                {
                  "required": [
                    "pure_evaluate"
                  ]
                },
                {
                  "required": [
                    "composite"
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "schema_version": {
                "const": 3
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "applicability": {
                "properties": {
                  "execution_domains": {
                    "items": {
                      "const": "fluid"
                    }
                  }
                },
                "type": "object"
              },
              "hydraulic_dependencies": {
                "type": "object"
              },
              "dependency_mode": {
                "type": "string"
              },
              "pure_evaluate": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "else": {
            "not": {
              "required": [
                "execution_role"
              ]
            }
          },
          "if": {
            "properties": {
              "schema_version": {
                "const": 4
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "execution_role": {
                "const": "refrigeration.isenthalpic_throttle.v1"
              },
              "applicability": {
                "properties": {
                  "execution_domains": {
                    "items": {
                      "const": "refrigeration"
                    }
                  }
                },
                "type": "object"
              },
              "solver_model": {
                "const": "generic"
              },
              "state_model": {
                "type": "null"
              },
              "thermal_model": {
                "type": "null"
              },
              "source_format": {
                "const": "python-v1"
              },
              "channels": {
                "maxItems": 0
              }
            },
            "required": [
              "execution_role"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  1,
                  2
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "applicability"
              ]
            }
          }
        }
      ],
      "description": "Schema-dispatched module facade; v1 never receives SDK default fields.",
      "properties": {
        "schema_version": {
          "default": 1,
          "enum": [
            1,
            2,
            3,
            4
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "category": {
          "default": "自定义模块",
          "title": "Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "title": "Ports",
          "type": "array"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Parameters",
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableSpec"
          },
          "title": "Variables",
          "type": "array"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "title": "Channels",
          "type": "array"
        },
        "solver_model": {
          "default": "generic",
          "title": "Solver Model",
          "type": "string"
        },
        "state_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Model"
        },
        "thermal_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermal Model"
        },
        "source_format": {
          "default": "python-v1",
          "title": "Source Format",
          "type": "string"
        },
        "source": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Source",
          "type": "object"
        },
        "runtime": {
          "default": "builtin",
          "enum": [
            "builtin",
            "python"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "entrypoint": {
          "default": "",
          "title": "Entrypoint",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "definition_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Hash"
        },
        "package_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Path"
        },
        "bank_names": {
          "items": {
            "type": "string"
          },
          "title": "Bank Names",
          "type": "array"
        },
        "sdk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleSDKRequirements"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "applicability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleApplicability"
            },
            {
              "$ref": "#/$defs/RefrigerationApplicability"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicability"
        },
        "execution_role": {
          "anyOf": [
            {
              "const": "refrigeration.isenthalpic_throttle.v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Role"
        },
        "hydraulic_dependencies": {
          "anyOf": [
            {
              "patternProperties": {
                "^[A-Za-z][A-Za-z0-9_-]{0,80}$": {
                  "items": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hydraulic Dependencies"
        },
        "dependency_mode": {
          "anyOf": [
            {
              "enum": [
                "conservative",
                "tracked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Mode"
        },
        "pure_evaluate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pure Evaluate"
        },
        "composite": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositeDefinition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ModuleDefinition",
      "type": "object"
    },
    "ModuleExecutionInfo": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "default": "manual",
          "enum": [
            "manual",
            "initialize",
            "evaluate",
            "thermal",
            "observe",
            "jacobian",
            "commit_step",
            "finalize"
          ],
          "title": "Phase",
          "type": "string"
        },
        "time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
