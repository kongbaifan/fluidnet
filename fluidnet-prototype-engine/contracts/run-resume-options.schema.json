      "default": null,
      "title": "Duration S"
    },
    "start_paused": {
      "default": true,
      "title": "Start Paused",
      "type": "boolean"
    }
  },
  "title": "RunResumeOptions",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
