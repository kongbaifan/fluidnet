        "solve_counters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solve Counters"
        },
        "solve_summary": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solve Summary"
        },
        "full": {
          "default": true,
          "title": "Full",
          "type": "boolean"
        },
        "sequence": {
          "default": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "parameter_revision": {
          "default": 0,
          "title": "Parameter Revision",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "valid",
        "time_s"
      ],
      "title": "RunFrame",
      "type": "object"
