        },
        "time_s": {
          "title": "Time S",
          "type": "number"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
