{
  "$defs": {
    "BatchRunOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "steady",
          "enum": [
            "steady",
            "dynamic"
          ],
          "title": "Mode",
          "type": "string"
        },
        "duration_s": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 604800,
          "title": "Duration S",
          "type": "number"
        },
        "dt_s": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Dt S",
          "type": "number"
        }
      },
      "title": "BatchRunOptions",
      "type": "object"
    },
    "ParameterSweep": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Instance Id",
          "type": "string"
        },
        "parameter_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/SweepRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "instance_id",
        "parameter_id"
      ],
      "title": "ParameterSweep",
      "type": "object"
    },
    "SweepRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "stop": {
          "title": "Stop",
          "type": "number"
        },
        "count": {
          "maximum": 20,
          "minimum": 2,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "stop",
        "count"
      ],
      "title": "SweepRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "sweep": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParameterSweep"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scenario_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Scenario Ids",
      "type": "array"
    },
    "variables": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Variables",
      "type": "array"
    },
    "options": {
      "$ref": "#/$defs/BatchRunOptions"
    }
  },
  "required": [
    "variables"
  ],
  "title": "BatchPlanRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
