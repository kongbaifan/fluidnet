{
  "$defs": {
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "input_port": {
          "title": "Input Port",
          "type": "string"
        },
        "output_port": {
          "title": "Output Port",
          "type": "string"
        },
        "relation": {
          "enum": [
            "resistance",
            "pump_curve",
            "pressure_source",
            "heat_transfer",
            "signal"
          ],
          "title": "Relation",
          "type": "string"
        },
        "solver_model": {
          "title": "Solver Model",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "input_port",
        "output_port",
        "relation",
        "solver_model"
      ],
      "title": "ChannelSpec",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "in",
        "out",
        "bidirectional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Domain": {
      "enum": [
        "fluid",
        "info",
        "power",
        "mech"
      ],
      "title": "Domain",
      "type": "string"
    },
    "FluidConfig": {
      "additionalProperties": false,
      "description": "Serializable fluid selection passed to the property service.",
      "properties": {
        "backend": {
          "const": "coolprop",
          "default": "coolprop",
          "title": "Backend",
          "type": "string"
        },
        "fluid": {
          "default": "Water",
          "title": "Fluid",
          "type": "string"
        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        },
        "reference": {
          "default": "mass",
          "enum": [
            "mass",
            "mole"
          ],
          "title": "Reference",
          "type": "string"
        },
        "phase_policy": {
          "default": "single_phase",
          "enum": [
            "single_phase",
            "liquid",
            "gas",
            "any"
          ],
          "title": "Phase Policy",
          "type": "string"
        }
      },
      "title": "FluidConfig",
      "type": "object"
    },
    "ModuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "category": {
          "default": "自定义模块",
          "title": "Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "title": "Ports",
          "type": "array"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Parameters",
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableSpec"
          },
          "title": "Variables",
          "type": "array"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "title": "Channels",
          "type": "array"
        },
        "solver_model": {
          "default": "generic",
          "title": "Solver Model",
          "type": "string"
        },
        "state_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Model"
        },
        "thermal_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermal Model"
        },
        "source_format": {
          "default": "python-v1",
          "title": "Source Format",
          "type": "string"
        },
        "source": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Source",
          "type": "object"
        },
        "runtime": {
          "default": "builtin",
          "enum": [
            "builtin",
            "python"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "entrypoint": {
          "default": "",
          "title": "Entrypoint",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "definition_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Hash"
        },
        "package_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Path"
        },
        "bank_names": {
          "items": {
            "type": "string"
          },
          "title": "Bank Names",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ModuleDefinition",
      "type": "object"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value_type": {
          "default": "number",
          "enum": [
            "number",
            "boolean",
            "text",
            "curve"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "default": {
          "title": "Default"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "runtime": {
          "default": false,
          "title": "Runtime",
          "type": "boolean"
        },
        "writable": {
          "default": true,
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "default"
      ],
      "title": "ParameterSpec",
      "type": "object"
    },
    "PortSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain",
          "default": "fluid"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "bidirectional"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "circuit": {
          "default": "fluid",
          "title": "Circuit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "PortSpec",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        },
        "display_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Display Scale",
          "type": "number"
        },
        "display_offset": {
          "default": 0.0,
          "title": "Display Offset",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "canonical_unit",
        "display_unit"
      ],
      "title": "UnitSpec",
      "type": "object"
    },
    "VariableSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "enum": [
            "parameter",
            "port",
            "state",
            "derived",
            "system"
          ],
          "title": "Source",
          "type": "string"
        },
        "writable": {
          "default": false,
          "title": "Writable",
          "type": "boolean"
        },
        "sampleable": {
          "default": true,
          "title": "Sampleable",
          "type": "boolean"
        },
        "parameter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Id"
        },
        "port_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port Id"
        }
      },
      "required": [
        "id",
        "label",
        "quantity",
        "source"
      ],
      "title": "VariableSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "fluid": {
      "$ref": "#/$defs/FluidConfig"
    },
    "inlet_pressure_pa": {
      "default": 250000.0,
      "exclusiveMinimum": 0,
      "title": "Inlet Pressure Pa",
      "type": "number"
    },
    "outlet_pressure_pa": {
      "default": 120000.0,
      "exclusiveMinimum": 0,
      "title": "Outlet Pressure Pa",
      "type": "number"
    },
    "temperature_k": {
      "default": 293.15,
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "duration_s": {
      "default": 0.1,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Duration S",
      "type": "number"
    },
    "dt_s": {
      "default": 0.1,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Dt S",
      "type": "number"
    },
    "module": {
      "$ref": "#/$defs/ModuleDefinition"
    }
  },
  "required": [
    "module"
  ],
  "title": "ModuleTestRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
