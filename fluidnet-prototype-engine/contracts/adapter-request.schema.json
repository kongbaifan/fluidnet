{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "title": "Adapter Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Inputs",
      "type": "object"
    },
    "input_units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Units",
      "type": "object"
    },
    "output_units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Units",
      "type": "object"
    }
  },
  "required": [
    "adapter_id"
  ],
  "title": "AdapterRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
