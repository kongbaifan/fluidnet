{
  "$defs": {
    "BatchAttempt": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        }
      },
      "required": [
        "run_id",
        "status",
        "started_at"
      ],
      "title": "BatchAttempt",
      "type": "object"
    },
    "BatchControlSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "enabled",
        "content_hash"
      ],
      "title": "BatchControlSource",
      "type": "object"
    },
    "BatchItemResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "parameter_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Value"
        },
        "parameter_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Unit"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/BatchAttempt"
          },
          "title": "Attempts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "scenario_id",
        "status"
      ],
      "title": "BatchItemResponse",
      "type": "object"
    },
    "BatchModuleSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "definition_hash": {
          "title": "Definition Hash",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "definition_hash"
      ],
      "title": "BatchModuleSource",
      "type": "object"
    },
    "BatchRunOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "steady",
          "enum": [
            "steady",
            "dynamic"
          ],
          "title": "Mode",
          "type": "string"
        },
        "duration_s": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 604800,
          "title": "Duration S",
          "type": "number"
        },
        "dt_s": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Dt S",
          "type": "number"
        }
      },
      "title": "BatchRunOptions",
      "type": "object"
    },
    "BatchSource": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "title": "Project Name",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "snapshot_hash": {
          "title": "Snapshot Hash",
          "type": "string"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/BatchModuleSource"
          },
          "title": "Modules",
          "type": "array"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/BatchControlSource"
          },
          "title": "Controls",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "revision",
        "snapshot_hash",
        "modules",
        "controls"
      ],
      "title": "BatchSource",
      "type": "object"
    },
    "BatchVariable": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/UnitSpec"
        }
      },
      "required": [
        "key",
        "label",
        "unit"
      ],
      "title": "BatchVariable",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Id"
        },
        "module_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Version"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "channel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "first_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Time S"
        },
        "last_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Time S"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        },
        "display_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Display Scale",
          "type": "number"
        },
        "display_offset": {
          "default": 0.0,
          "title": "Display Offset",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "canonical_unit",
        "display_unit"
      ],
      "title": "UnitSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "project_name": {
      "title": "Project Name",
      "type": "string"
    },
    "project_revision": {
      "title": "Project Revision",
      "type": "integer"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "completed",
        "completed_with_errors",
        "cancelled",
        "interrupted",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "completed": {
      "title": "Completed",
      "type": "integer"
    },
    "failed": {
      "title": "Failed",
      "type": "integer"
    },
    "cancelled": {
      "title": "Cancelled",
      "type": "integer"
    },
    "interrupted": {
      "title": "Interrupted",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "source": {
      "$ref": "#/$defs/BatchSource"
    },
    "options": {
      "$ref": "#/$defs/BatchRunOptions"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/BatchVariable"
      },
      "title": "Variables",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BatchItemResponse"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "project_id",
    "project_name",
    "project_revision",
    "snapshot_hash",
    "status",
    "created_at",
    "updated_at",
    "total",
    "completed",
    "failed",
    "cancelled",
    "interrupted",
    "source",
    "options",
    "variables",
    "items"
  ],
  "title": "BatchDetailResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
