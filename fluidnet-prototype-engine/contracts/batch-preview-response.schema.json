{
  "$defs": {
    "BatchControlSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "enabled",
        "content_hash"
      ],
      "title": "BatchControlSource",
      "type": "object"
    },
    "BatchModuleSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "definition_hash": {
          "title": "Definition Hash",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "definition_hash"
      ],
      "title": "BatchModuleSource",
      "type": "object"
    },
    "BatchPreviewItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "source_scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Scenario Id"
        },
        "parameter_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Value"
        },
        "parameter_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Unit"
        }
      },
      "required": [
        "id",
        "name",
        "scenario"
      ],
      "title": "BatchPreviewItem",
      "type": "object"
    },
    "BatchRunOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "steady",
          "enum": [
            "steady",
            "dynamic"
          ],
          "title": "Mode",
          "type": "string"
        },
        "duration_s": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 604800,
          "title": "Duration S",
          "type": "number"
        },
        "dt_s": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Dt S",
          "type": "number"
        }
      },
      "title": "BatchRunOptions",
      "type": "object"
    },
    "BatchSource": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "title": "Project Name",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "snapshot_hash": {
          "title": "Snapshot Hash",
          "type": "string"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/BatchModuleSource"
          },
          "title": "Modules",
          "type": "array"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/BatchControlSource"
          },
          "title": "Controls",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "revision",
        "snapshot_hash",
        "modules",
        "controls"
      ],
      "title": "BatchSource",
      "type": "object"
    },
    "BatchVariable": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/UnitSpec"
        }
      },
      "required": [
        "key",
        "label",
        "unit"
      ],
      "title": "BatchVariable",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Overrides",
          "type": "object"
        },
        "events": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ScheduleEvent"
              },
              "maxItems": 500,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Events"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScheduleEvent": {
      "additionalProperties": false,
      "description": "A load or operation event at a simulation time (cold-store projects; canonical units).\n\ndoor_heat: `heat_w` for `duration_s` [time_s, time_s + duration_s); goods_addition: `mass_kg` frozen goods\nat `temperature_k`, mixed by energy; ambient_temperature: outdoor `temperature_k` from `time_s` on;\nelectric_defrost: start one defrost cycle of the target cooler; set_variable: write `value` to `key`\n(`<instance>.param.<runtime parameter>` or `controller.<id>.setpoint|manual_output`) like a run command.\n`instance_id` may be omitted when the project has exactly one matching device (ambient: every device\nwith an outdoor temperature).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "door_heat",
            "goods_addition",
            "ambient_temperature",
            "electric_defrost",
            "set_variable"
          ],
          "title": "Type",
          "type": "string"
        },
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "instance_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "heat_w": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heat W"
        },
        "mass_kg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Kg"
        },
        "temperature_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "key": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "type",
        "time_s"
      ],
      "title": "ScheduleEvent",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        },
        "display_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Display Scale",
          "type": "number"
        },
        "display_offset": {
          "default": 0.0,
          "title": "Display Offset",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "canonical_unit",
        "display_unit"
      ],
      "title": "UnitSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/BatchSource"
    },
    "options": {
      "$ref": "#/$defs/BatchRunOptions"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/BatchVariable"
      },
      "title": "Variables",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BatchPreviewItem"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "preview_hash": {
      "title": "Preview Hash",
      "type": "string"
    }
  },
  "required": [
    "source",
    "options",
    "variables",
    "items",
    "preview_hash"
  ],
  "title": "BatchPreviewResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
