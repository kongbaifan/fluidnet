        },
        "channel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "first_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Time S"
        },
        "last_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Time S"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        },
        "display_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Display Scale",
          "type": "number"
        },
        "display_offset": {
          "default": 0.0,
          "title": "Display Offset",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "canonical_unit",
        "display_unit"
      ],
      "title": "UnitSpec",
      "type": "object"
