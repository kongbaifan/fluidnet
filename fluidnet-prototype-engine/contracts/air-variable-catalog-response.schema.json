    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "project_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Revision"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/AirVariableDescriptor"
      },
      "title": "Variables",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "variables"
  ],
  "title": "AirVariableCatalogResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
