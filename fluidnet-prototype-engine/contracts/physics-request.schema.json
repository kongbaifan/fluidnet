{
  "$defs": {
    "ModuleRequestContext": {
      "additionalProperties": false,
      "description": "Optional transport metadata; callback phase/time are derived from the action itself.",
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "accepted_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Time S"
        },
        "port_data": {
          "default": "trial",
          "enum": [
            "trial",
            "converged"
          ],
          "title": "Port Data",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "ModuleRequestContext",
      "type": "object"
    },
    "PhysicsInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "compressor",
            "condenser"
          ],
          "title": "Kind",
          "type": "string"
        },
        "inlet_pressure_pa": {
          "exclusiveMinimum": 0,
          "title": "Inlet Pressure Pa",
          "type": "number"
        },
        "outlet_pressure_pa": {
          "exclusiveMinimum": 0,
          "title": "Outlet Pressure Pa",
          "type": "number"
        },
        "inlet_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Inlet Temperature K",
          "type": "number"
        },
        "inlet_enthalpy_j_kg": {
          "title": "Inlet Enthalpy J Kg",
          "type": "number"
        },
        "inlet_density_kg_m3": {
          "exclusiveMinimum": 0,
          "title": "Inlet Density Kg M3",
          "type": "number"
        },
        "isentropic_outlet_enthalpy_j_kg": {
          "title": "Isentropic Outlet Enthalpy J Kg",
          "type": "number"
        },
        "sink_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Sink Temperature K",
          "type": "number"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "inlet_pressure_pa",
        "outlet_pressure_pa",
        "inlet_temperature_k",
        "inlet_enthalpy_j_kg",
        "inlet_density_kg_m3",
        "isentropic_outlet_enthalpy_j_kg",
        "sink_temperature_k",
        "enabled"
      ],
      "title": "PhysicsInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "instance_id": {
      "title": "Instance Id",
      "type": "string"
    },
    "iteration_id": {
      "minimum": 0,
      "title": "Iteration Id",
      "type": "integer"
    },
    "time_s": {
      "minimum": 0,
      "title": "Time S",
      "type": "number"
    },
    "point": {
      "$ref": "#/$defs/PhysicsInput"
    },
    "state_revision": {
      "minimum": 0,
      "title": "State Revision",
      "type": "integer"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModuleRequestContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "instance_id",
    "iteration_id",
    "time_s",
    "point",
    "state_revision"
  ],
  "title": "PhysicsRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
