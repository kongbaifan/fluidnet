{
  "$defs": {
    "BatchVariable": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/UnitSpec"
        }
      },
      "required": [
        "key",
        "label",
        "unit"
      ],
      "title": "BatchVariable",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        },
        "display_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Display Scale",
          "type": "number"
        },
        "display_offset": {
          "default": 0.0,
          "title": "Display Offset",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "canonical_unit",
        "display_unit"
      ],
      "title": "UnitSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "variable": {
      "$ref": "#/$defs/BatchVariable"
    },
    "points": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        ],
        "type": "array"
      },
      "maxItems": 2000,
      "title": "Points",
      "type": "array"
    },
    "stride": {
      "minimum": 1,
      "title": "Stride",
      "type": "integer"
    },
    "total_rows": {
      "minimum": 0,
      "title": "Total Rows",
      "type": "integer"
    }
  },
  "required": [
    "batch_id",
    "item_id",
    "status",
    "variable",
    "points",
    "stride",
    "total_rows"
  ],
  "title": "BatchCurveResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
