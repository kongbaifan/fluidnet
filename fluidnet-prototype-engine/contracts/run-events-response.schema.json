{
  "$defs": {
    "RunCommand": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "pause",
            "resume",
            "step",
            "stop",
            "set",
            "controller"
          ],
          "title": "Action",
          "type": "string"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "parameter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Id"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "command_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "controller_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controller Id"
        }
      },
      "required": [
        "action"
      ],
      "title": "RunCommand",
      "type": "object"
    },
    "RunEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "time_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "command_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Status"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameter_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Revision"
        }
      },
      "required": [
        "type"
      ],
      "title": "RunEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/RunEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "RunEventsResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
