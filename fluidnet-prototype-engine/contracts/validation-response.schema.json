{
  "$defs": {
    "CircuitInfo": {
      "additionalProperties": false,
      "description": "One fluid circuit of a compiled project: its fluid and the ports it contains.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "fluid": {
          "$ref": "#/$defs/FluidConfig"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ports": {
          "items": {
            "type": "string"
          },
          "title": "Ports",
          "type": "array"
        }
      },
      "required": [
        "id",
        "fluid",
        "source"
      ],
      "title": "CircuitInfo",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Id"
        },
        "module_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Version"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "channel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "first_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Time S"
        },
        "last_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Time S"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "FluidConfig": {
      "additionalProperties": false,
      "description": "Serializable fluid selection passed to the property service.",
      "properties": {
        "backend": {
          "const": "coolprop",
          "default": "coolprop",
          "title": "Backend",
          "type": "string"
        },
        "fluid": {
          "default": "Water",
          "title": "Fluid",
          "type": "string"
        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        },
        "reference": {
          "default": "mass",
          "enum": [
            "mass",
            "mole"
          ],
          "title": "Reference",
          "type": "string"
        },
        "phase_policy": {
          "default": "single_phase",
          "enum": [
            "single_phase",
            "liquid",
            "gas",
            "any"
          ],
          "title": "Phase Policy",
          "type": "string"
        }
      },
      "title": "FluidConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "circuits": {
      "items": {
        "$ref": "#/$defs/CircuitInfo"
      },
      "title": "Circuits",
      "type": "array"
    }
  },
  "required": [
    "valid"
  ],
  "title": "ValidationResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
