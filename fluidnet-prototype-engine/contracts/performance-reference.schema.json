{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "content_hash"
  ],
  "title": "PerformanceReference",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
