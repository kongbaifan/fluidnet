{
  "$defs": {
    "ModuleRequestContext": {
      "additionalProperties": false,
      "description": "Optional transport metadata; callback phase/time are derived from the action itself.",
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "accepted_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Time S"
        },
        "port_data": {
          "default": "trial",
          "enum": [
            "trial",
            "converged"
          ],
          "title": "Port Data",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "ModuleRequestContext",
      "type": "object"
    },
    "PortState": {
      "additionalProperties": false,
      "properties": {
        "pressure_pa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Pa"
        },
        "temperature_k": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "enthalpy_j_kg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enthalpy J Kg"
        },
        "density_kg_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Density Kg M3"
        },
        "viscosity_pa_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viscosity Pa S"
        },
        "specific_heat_j_kg_k": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specific Heat J Kg K"
        },
        "mass_flow_kg_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Flow Kg S"
        },
        "quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        }
      },
      "title": "PortState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
      "title": "Run Id",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$",
      "title": "Instance Id",
      "type": "string"
    },
    "iteration_id": {
      "minimum": 0,
      "title": "Iteration Id",
      "type": "integer"
    },
    "time_s": {
      "minimum": 0,
      "title": "Time S",
      "type": "number"
    },
    "trial_ports": {
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]{0,80}$": {
          "$ref": "#/$defs/PortState"
        }
      },
      "title": "Trial Ports",
      "type": "object"
    },
    "readonly_state": {
      "additionalProperties": true,
      "title": "Readonly State",
      "type": "object"
    },
    "state_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State Revision"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModuleRequestContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "instance_id",
    "iteration_id",
    "time_s"
  ],
  "title": "EvaluateRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
