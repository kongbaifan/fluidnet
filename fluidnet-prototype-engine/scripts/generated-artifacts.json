{
  "version": 1,
  "generators": [
    {"id": "contracts", "script": "scripts/generate_contracts.py", "outputs": ["contracts/*.json"]},
    {"id": "coupled-liquid", "script": "scripts/generate_coupled_liquid_example.py", "outputs": ["examples/coupled_liquid_modules/author_loop.json"]},
    {"id": "room-control", "script": "scripts/generate_room_control_examples.py", "outputs": ["examples/room-control/*.project.json"]},
    {"id": "hvac", "script": "scripts/generate_hvac_examples.py", "outputs": ["examples/hvac-basic/*.project.json"]},
    {"id": "hvac-modules", "script": "scripts/generate_hvac_modules.py", "outputs": ["modules/*/manifest.json", "modules/*/module.py"]},
    {"id": "hvac-expansion", "script": "scripts/generate_hvac_expansion.py", "outputs": ["examples/hvac-expansion/*.json", "modules/*/manifest.json", "modules/*/module.py"]},
    {"id": "regulating-valves", "script": "scripts/generate_regulating_valves.py", "outputs": ["examples/regulating-valves/*.json", "modules/*/manifest.json", "modules/*/module.py"]},
    {"id": "simple-equipment", "script": "scripts/generate_simple_equipment.py", "outputs": ["examples/hvac-expansion/hydronic_boiler.*.json", "examples/hvac-expansion/geometry_bend.*.json", "modules/*/manifest.json", "modules/*/module.py"]},
    {"id": "design-groups", "script": "scripts/generate_design_groups.py", "outputs": ["examples/equipment-library/*.json", "modules/*/manifest.json", "modules/*/module.py", "modules/*/design.py"]},
    {"id": "forward-physics", "script": "scripts/generate_forward_physics.py", "outputs": ["examples/forward-physics/*.json"]},
    {"id": "hydronic-buffer", "script": "scripts/generate_hydronic_buffer.py", "outputs": ["examples/forward/hydronic-buffer*.json"]},
    {"id": "refrigeration-author", "script": "scripts/generate_refrigeration_author_example.py", "outputs": ["examples/refrigeration_extensions/author_station*.json"]},
    {"id": "open-refrigeration", "script": "scripts/generate_open_refrigeration_groups.py", "outputs": ["examples/open-refrigeration-groups/*.json"]}
  ]
}
